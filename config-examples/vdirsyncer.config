# vdirsyncer configuration for Fastmail CalDAV
#
# This is a template file. Agents should:
# 1. Read this template
# 2. Replace FASTMAIL_EMAIL and FASTMAIL_APP_PASSWORD with actual env values
# 3. Write to ~/.vdirsyncer/config
#
# Example usage:
#   sed -e "s/FASTMAIL_EMAIL/$FASTMAIL_EMAIL/g" \
#       -e "s/FASTMAIL_APP_PASSWORD/$FASTMAIL_APP_PASSWORD/g" \
#       config-examples/vdirsyncer.config > ~/.vdirsyncer/config

[general]
status_path = "~/.vdirsyncer/status/"

[pair fastmail_calendar]
a = "fastmail_remote"
b = "fastmail_local"
collections = ["from a", "from b"]

[storage fastmail_remote]
type = "caldav"
url = "https://caldav.fastmail.com/dav/calendars/user/FASTMAIL_EMAIL/"
username = "FASTMAIL_EMAIL"
password = "FASTMAIL_APP_PASSWORD"

[storage fastmail_local]
type = "filesystem"
path = "~/.calendar/fastmail"
fileext = ".ics"
